# Supabase URL and public client key may be used by the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1
VITE_DEMO_MODE=false

# Server-only Supabase configuration. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend-only Gemini configuration. GEMINI_MODEL is required when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_MOCK=false

# Backend runtime configuration.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
